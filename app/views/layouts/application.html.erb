<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Leave Desk" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#196244">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Leave Desk">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "calendars", "data-turbo-track": "reload" %>
  </head>

  <body class="<%= authenticated? ? "app-shell" : "auth-shell" %>">
    <% if authenticated? %>
      <header class="site-header">
        <div class="site-header__inner">
          <%= link_to root_path, class: "brand", aria: { label: "Leave Desk — главная" } do %>
            <span class="brand__mark" aria-hidden="true">LD</span>
            <span>Leave Desk</span>
          <% end %>

          <nav class="site-nav" aria-label="Основная навигация">
            <%= workspace_navigation_link "Мои заявки", leave_requests_path %>
            <% if Current.user.manager? || Current.user.administrator? %>
              <details class="site-nav__dropdown">
                <summary>Календари</summary>
                <div class="site-nav__menu">
                  <%= workspace_navigation_link "Общий календарь", manager_calendar_path %>
                  <%= workspace_navigation_link "Мой календарь", calendar_path %>
                </div>
              </details>
            <% else %>
              <%= workspace_navigation_link "Мой календарь", calendar_path %>
            <% end %>
            <%= workspace_navigation_link "Уведомления (#{unread_notifications_count})", notifications_path %>
            <% if Current.user.manager? %>
              <%= workspace_navigation_link "Заявки сотрудников", manager_leave_requests_path %>
            <% end %>
            <% if Current.user.administrator? %>
              <%= workspace_navigation_link "Семейные отпуска", admin_family_leaves_path %>
              <%= workspace_navigation_link "Виды отпусков", admin_leave_types_path %>
              <%= workspace_navigation_link "Федеральные календари", admin_federal_calendars_path %>
              <%= workspace_navigation_link "Регионы работы", admin_regions_path %>
              <%= workspace_navigation_link "Региональные календари", admin_regional_calendars_path %>
              <%= workspace_navigation_link "Проверка календаря", admin_calendar_reviews_path %>
            <% end %>
          </nav>

          <div class="user-menu">
            <span class="user-menu__name"><%= Current.user.name %></span>
            <%= button_to "Выйти", session_path, method: :delete %>
          </div>
        </div>
      </header>

      <%= tag.div(flash[:notice], class: "flash flash--notice", role: "status") if flash[:notice] %>
      <%= tag.div(flash[:alert], class: "flash flash--alert", role: "alert") if flash[:alert] %>
    <% end %>

    <%= yield %>
  </body>
</html>
