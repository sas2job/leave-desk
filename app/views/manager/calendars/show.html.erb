<main class="page calendar-page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Команда</p>
      <h1>Календарь <%= @month ? I18n.l(Date.new(@year, @month, 1), format: "%B %Y") : @year %></h1>
    </div>
    <div class="calendar-year-nav">
      <% if @month %>
        <% previous_month = Date.new(@year, @month, 1).prev_month %>
        <% next_month = Date.new(@year, @month, 1).next_month %>
        <% if previous_month.year >= CalendarWindow::FIRST_YEAR %>
          <%= link_to "← #{I18n.l(previous_month, format: "%B")}",
            manager_calendar_path(year: previous_month.year, month: previous_month.month),
            class: "button button--secondary" %>
        <% end %>
        <% if next_month.year <= CalendarWindow::LAST_YEAR %>
          <%= link_to "#{I18n.l(next_month, format: "%B")} →",
            manager_calendar_path(year: next_month.year, month: next_month.month),
            class: "button button--secondary" %>
        <% end %>
        <%= link_to "Весь год", manager_calendar_path(year: @year, month: "all"),
          class: "button button--secondary" %>
      <% else %>
        <% if @year > CalendarWindow::FIRST_YEAR %>
          <%= link_to "← #{@year - 1}", manager_calendar_path(year: @year - 1, month: "all"),
            class: "button button--secondary" %>
        <% end %>
        <% if @year < CalendarWindow::LAST_YEAR %>
          <%= link_to "#{@year + 1} →", manager_calendar_path(year: @year + 1, month: "all"),
            class: "button button--secondary" %>
        <% end %>
        <%= link_to "По месяцам", manager_calendar_path(year: @year),
          class: "button button--secondary" %>
      <% end %>
    </div>
  </header>
  <div class="calendar-legend">
    <span class="calendar-legend__item"><span class="calendar-key calendar-key--leave"></span> Согласованный отпуск</span>
    <span class="calendar-legend__item"><span class="calendar-key calendar-key--birthday"></span> День рождения</span>
  </div>
  <div class="team-calendar-wrap <%= "team-calendar-wrap--month" if @month %>">
    <table class="team-calendar <%= "team-calendar--month" if @month %>">
      <thead>
        <tr>
          <th rowspan="2" scope="col">Сотрудник</th>
          <% @dates.group_by(&:month).each_value do |dates| %>
            <th colspan="<%= dates.size %>" scope="colgroup"><%= I18n.l(dates.first, format: "%B") %></th>
          <% end %>
        </tr>
        <tr>
          <% @dates.each do |date| %>
            <th scope="col" class="<%= "weekend" if @calendar_off_days.include?(date) %>">
              <%= date.day %><small><%= I18n.l(date, format: "%a") %></small>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <th scope="row"><%= row[:employee].name %></th>
            <% @dates.each do |date| %>
              <% leave = row[:leave_days].include?(date) %>
              <% birthday = row[:birthday] == date %>
              <% classes = [] %>
              <% classes << "weekend" if @calendar_off_days.include?(date) %>
              <% classes << "leave" if leave %>
              <% classes << "birthday" if birthday %>
              <% labels = [format_date(date)] %>
              <% labels << "Отпуск согласован" if leave %>
              <% labels << "День рождения" if birthday %>
              <td class="<%= classes.join(" ") %>" title="<%= labels.join(" — ") %>" aria-label="<%= labels.join(" — ") %>">
                <% if leave && birthday %>
                  <span class="calendar-half calendar-half--approved">О</span>
                  <span class="calendar-birthday">ДР</span>
                <% elsif leave %>
                  О
                <% elsif birthday %>
                  ДР
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>
