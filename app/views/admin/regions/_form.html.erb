<% if region.errors.any? %>
  <div class="error-summary" role="alert">
    <strong>Проверьте заполнение формы</strong>
    <ul><% region.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
<section class="card form-card">
  <%= form_with model: [:admin, region] do |form| %>
    <div class="form-grid">
      <div class="field">
        <%= form.label :code, "Код региона ISO 3166-2" %>
        <% if region.persisted? %>
          <%= form.text_field :code, disabled: true %>
        <% else %>
          <%= form.text_field :code, required: true, maxlength: 6, placeholder: "RU-TA" %>
        <% end %>
      </div>
      <div class="field">
        <%= form.label :name, "Название региона" %>
        <%= form.text_field :name, required: true, maxlength: 100, placeholder: "Республика Татарстан" %>
      </div>
    </div>
    <div class="form-actions">
      <%= form.submit region.persisted? ? "Сохранить" : "Добавить" %>
      <%= link_to "Отмена", admin_regions_path, class: "button button--secondary" %>
    </div>
  <% end %>
</section>
