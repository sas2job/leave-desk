<main class="page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Администрирование</p>
      <h1>Сотрудники</h1>
      <p class="lede">Управляйте доступом, ролями и структурой подчинения.</p>
    </div>
    <%= link_to "Добавить сотрудника", new_admin_user_path, class: "button" %>
  </header>

  <% if @users.any? %>
    <div class="request-list">
      <% @users.each do |user| %>
        <article class="request-card">
          <div class="request-card__summary">
            <div class="request-card__title"><%= user.name %></div>
            <span class="status <%= "status--approved" if user.active? %>">
              <%= user.active? ? "Активен" : "Отключён" %>
            </span>
          </div>
          <div class="request-card__meta">
            <div>
              <div class="meta-label">Email</div>
              <div class="meta-value"><%= user.email_address %></div>
            </div>
            <div>
              <div class="meta-label">Роль</div>
              <div class="meta-value"><%= { "employee" => "Сотрудник", "manager" => "Руководитель", "administrator" => "Администратор" }.fetch(user.role) %></div>
            </div>
            <div>
              <div class="meta-label">Руководитель</div>
              <div class="meta-value"><%= user.manager&.name || "Не назначен" %></div>
            </div>
          </div>
          <div class="request-card__actions">
            <%= link_to "Изменить", edit_admin_user_path(user), class: "button button--secondary" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <section class="card empty-state">
      <h2>Сотрудников пока нет</h2>
      <p>Добавьте первого пользователя системы.</p>
    </section>
  <% end %>
</main>
