<% content_for :head do %><%= javascript_include_tag "user_annual_entitlement", defer: true %><% end %>
<% if user.errors.any? %>
  <div class="error-summary" role="alert">
    <strong>Проверьте заполнение формы</strong>
    <ul>
      <% user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<section class="card form-card">
  <%= form_with model: [:admin, user] do |form| %>
    <div class="form-grid">
      <div class="field">
        <%= form.label :name, "Имя" %>
        <%= form.text_field :name, required: true, maxlength: 100, autocomplete: "name" %>
      </div>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, maxlength: 254, autocomplete: "email" %>
      </div>
      <div class="field">
        <%= form.label :city, "Город проживания" %>
        <%= form.select :city, User::CITY_TIME_ZONES.keys, { include_blank: "Выберите город" }, required: true %>
      </div>
      <div class="field">
        <%= form.label :region_id, "Регион работы" %>
        <%= form.collection_select :region_id, @region_options, :id, :name,
          { include_blank: "Не указан (только федеральный календарь)" } %>
      </div>
      <div class="field">
        <%= form.label :birthday_on, "День рождения" %>
        <%= form.date_field :birthday_on, value: user.birthday_on.is_a?(Date) ? user.birthday_on.iso8601 : nil %>
      </div>
      <div class="field">
        <%= form.label :role, "Роль" %>
        <%= form.select :role, [["Сотрудник", "employee"], ["Руководитель", "manager"], ["Администратор", "administrator"]] %>
      </div>
      <div class="field">
        <%= form.label :manager_id, "Непосредственный руководитель" %>
        <%= form.collection_select :manager_id, @manager_options, :id, :name, { include_blank: "Не назначен" } %>
      </div>
      <div class="field">
        <%= form.label :password, user.persisted? ? "Новый пароль" : "Пароль" %>
        <%= form.password_field :password, required: !user.persisted?,
          minlength: User::MINIMUM_PASSWORD_LENGTH, autocomplete: "new-password" %>
        <small>Не менее <%= User::MINIMUM_PASSWORD_LENGTH %> символов.</small>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Подтверждение пароля" %>
        <%= form.password_field :password_confirmation, required: !user.persisted?, autocomplete: "new-password" %>
      </div>
      <div class="field field--full checkbox-field">
        <%= form.check_box :extended_annual_leave %>
        <%= form.label :extended_annual_leave, "Увеличенная продолжительность основного отпуска (от 30 дней)" %>
      </div>
      <div class="field">
        <%= form.label :annual_base_days, "Основной отпуск за рабочий год, дней" %>
        <%= form.number_field :annual_base_days, min: 28, required: true %>
        <small>Обычно 28; для работников с инвалидностью — не менее 30. Для работников младше 18 лет при настройке рабочего года учитывается минимум 31 день. При увеличении укажите основание без медицинских сведений.</small>
      </div>
      <div class="field">
        <%= form.label :annual_additional_days, "Дополнительные дни за ненормированный рабочий день" %>
        <%= form.number_field :annual_additional_days, min: 0, required: true %>
        <small>0, если не предусмотрен; иначе не менее 3 дней по установленным правилам организации.</small>
      </div>
      <div class="field field--full">
        <%= form.label :annual_leave_basis, "Основание увеличения отпуска" %>
        <%= form.text_field :annual_leave_basis, maxlength: 200 %>
        <small>Укажите норму или документ организации без медицинских сведений. Изменение профиля действует для новых рабочих лет; существующие остатки корректируются отдельно.</small>
      </div>
      <div class="field field--full checkbox-field">
        <%= form.check_box :active %>
        <%= form.label :active, "Учётная запись активна" %>
      </div>
    </div>
    <div class="form-actions">
      <%= form.submit user.persisted? ? "Сохранить" : "Добавить" %>
      <%= link_to "Отмена", admin_users_path, class: "button button--secondary" %>
    </div>
  <% end %>
</section>
