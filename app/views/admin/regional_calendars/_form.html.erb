<% if calendar.errors.any? %>
  <div class="error-summary" role="alert">
    <strong>Проверьте заполнение формы</strong>
    <ul><% calendar.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
<section class="card form-card">
  <%= form_with model: [:admin, calendar] do |form| %>
    <div class="form-grid">
      <div class="field">
        <%= form.label :region_id, "Регион работы" %>
        <% if calendar.persisted? %>
          <%= form.text_field :region_id, value: calendar.region.name, disabled: true %>
        <% else %>
          <%= form.collection_select :region_id, @region_options, :id, :name,
            { include_blank: "Выберите регион" }, required: true %>
          <small><%= link_to "Добавить регион", new_admin_region_path %></small>
        <% end %>
      </div>
      <div class="field">
        <%= form.label :year, "Год" %>
        <% if calendar.persisted? %>
          <%= form.number_field :year, disabled: true %>
        <% else %>
          <%= form.number_field :year, min: SupportedCalendarPeriod::YEARS.first,
            max: SupportedCalendarPeriod::YEARS.last, required: true %>
        <% end %>
      </div>
      <div class="field field--full">
        <%= form.label :legal_basis, "Нормативное основание" %>
        <%= form.text_area :legal_basis, required: true, maxlength: 1_000, rows: 3,
          placeholder: "Закон региона, постановление о датах подвижных праздников" %>
      </div>
      <div class="field field--full">
        <%= form.label :public_holidays_input, "Региональные нерабочие праздничные даты" %>
        <p>Одна дата в строке, ГГГГ-ММ-ДД. Эти даты исключаются из ежегодного отпуска сотрудника данного региона. Федеральные даты добавляются автоматически.</p>
        <%= form.text_area :public_holidays_input, rows: 9 %>
      </div>
      <div class="field field--full">
        <%= form.label :additional_days_off_input, "Дополнительные выходные (переносы)" %>
        <p>Одна дата в строке, ГГГГ-ММ-ДД. Эти дни отмечаются в календаре, но входят в длительность ежегодного отпуска.</p>
        <%= form.text_area :additional_days_off_input, rows: 6 %>
      </div>
      <div class="field field--full checkbox-field">
        <%= form.check_box :complete %>
        <%= form.label :complete, "Все региональные праздничные даты этого года подтверждены по НПА" %>
      </div>
    </div>
    <div class="form-actions">
      <%= form.submit calendar.persisted? ? "Сохранить" : "Добавить" %>
      <%= link_to "Отмена", admin_regional_calendars_path, class: "button button--secondary" %>
    </div>
  <% end %>
</section>
