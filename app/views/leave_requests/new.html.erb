<% content_for :head do %>
  <%= javascript_include_tag "leave_request_dates", defer: true %>
<% end %>

<main class="page page--narrow">
  <header class="page-header">
    <div>
      <p class="eyebrow">Новая заявка</p>
      <h1>Запланировать отпуск</h1>
      <p class="lede" data-period-guidance><% if @leave_request.leave_type&.full_day_only? %>Выберите полные календарные даты отпуска.<% else %>Выберите вид отпуска и даты отсутствия.<% end %></p>
    </div>
  </header>

  <% if @leave_request.errors.any? %>
    <div class="error-summary" role="alert">
      <strong>Проверьте заполнение формы</strong>
      <ul>
        <% @leave_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card form-card">
    <%= form_with model: @leave_request do |form| %>
      <div class="form-grid">
        <div class="field field--full">
          <%= form.label :leave_type_id, "Вид отпуска" %>
          <%= form.collection_select :leave_type_id, @leave_types, :id, :name,
            { prompt: "Выберите вид отпуска" },
            required: true, data: { planner_type: true,
              annual_type_id: @leave_types.find { |type| type.code == "ANNUAL" }&.id,
              full_day_type_ids: @leave_types.select(&:full_day_only?).map(&:id).join(","),
              statutory_type_ids: @leave_types.select(&:statutory_leave?).map(&:id).join(","),
              family_type_ids: @leave_types.select(&:family_leave?).map(&:id).join(","),
                sick_type_id: @leave_types.find { |type| type.code == "SICK" }&.id,
              childcare_type_id: @leave_types.find { |type| type.code == "CHILDCARE" }&.id,
              birthday_type_id: @leave_types.find { |type| type.code == "BIRTHDAY" }&.id,
              excluded_holiday_type_ids: @leave_types.select(&:exclude_public_holidays?).map(&:id).join(",") } %>
        </div>

        <%= form.hidden_field :resumes_request_id if @leave_request.resumes_request_id %>
        <%= tag.div class: "field field--full", data: { childcare_field: true }, hidden: !@leave_request.childcare_leave? do %>
          <%= form.label :child_born_on, "Дата рождения ребёнка (для отпуска по уходу)" %>
          <%= form.date_field :child_born_on, max: Date.current,
            disabled: !@leave_request.childcare_leave?, required: @leave_request.childcare_leave? %>
        <% end %>
        <%= tag.div class: "field field--full", data: { childcare_field: true }, hidden: !@leave_request.childcare_leave? do %>
          <%= form.label :care_relationship, "Кто осуществляет уход" %>
          <%= form.select :care_relationship, LeaveRequest.care_relationships.keys.map { |key| [care_relationship_label(key), key] },
            { include_blank: "Выберите для отпуска по уходу" },
            disabled: !@leave_request.childcare_leave?, required: @leave_request.childcare_leave? %>
        <% end %>
        <% {
          "ANNUAL" => "Ежегодный оплачиваемый отпуск исчисляется в календарных днях (ст. 120 ТК РФ). Выберите полные календарные даты: часы для этого вида не указываются. Выходные входят в отпуск, официальные праздники исключаются. Отпуск может переходить в следующий год.",
          "UNPAID" => "Отпуск без сохранения заработной платы оформляется по письменному заявлению; продолжительность определяется соглашением сторон (ст. 128 ТК РФ). В предусмотренных законом случаях работодатель обязан предоставить такой отпуск.",
          "MATERNITY" => "Укажите даты отпуска по беременности и родам по заявлению и документу. Отпуск оформляется на полные календарные дни и может переходить в следующий год. 140/156/194 дня — обычные варианты, не единственные допустимые сроки. Отпуск регистрирует администратор.",
          "CHILDCARE" => "Укажите дату рождения ребёнка и кто осуществляет уход. Отпуск оформляется на полные календарные дни и может переходить в следующий год. Отпуск регистрирует администратор.",
            "BIRTHDAY" => "Выходной в день рождения — один полный день один раз в календарном году.",
            "SICK" => "Укажите начало и предполагаемое окончание болезни. Только полные календарные дни; можно указать прошедшие даты и переход года. Руководитель подтверждает отсутствие для внутреннего учёта. Продление и закрытие доступны в этой же заявке. Медицинские документы и диагноз не требуются."
        }.each do |code, hint| %>
          <%= tag.div class: "field-hint field--full leave-type-guidance",
            data: { leave_type_hint: @leave_types.find { |type| type.code == code }&.id },
            hidden: @leave_request.leave_type&.code != code do %>
            <p><%= hint %></p>
            <% if code == "ANNUAL" %>
              <p><strong>Доступно на сегодня: <%= format_balance_days(@annual_available_minutes) %> дн.</strong> Ожидающие заявки резервируют дни. Для будущих рабочих лет доступность проверяется по дате начала отпуска. <%= link_to "Посмотреть остаток по рабочим годам", annual_leave_balance_path %></p>
              <p>По соглашению можно взять отдельный день. При разделении ежегодного отпуска хотя бы одна часть должна быть не менее 14 календарных дней (ст. 125 ТК РФ).</p>
              <p>Если нужно отсутствовать несколько часов, можно согласовать отпуск без сохранения заработной платы.</p>
              <p><%= link_to "Статьи 120 и 125 ТК РФ — пояснения Минтруда", "https://mintrud.gov.ru/ministry/programms/trudotn/otpusk", target: "_blank", rel: "noopener noreferrer" %></p>
            <% elsif code == "UNPAID" %>
              <p>По разъяснению Роструда отпуск за свой счёт можно согласовать на несколько часов. Для части дня снимите «Весь день» и укажите точное время начала и окончания.</p>
              <p><%= link_to "Разъяснение Роструда об отпуске на несколько часов", "https://онлайнинспекция.рф/questions/viewFaq/289", target: "_blank", rel: "noopener noreferrer" %></p>
            <% end %>
          <% end %>
        <% end %>

        <% %i[starts_on ends_on].each do |field| %>
          <div class="field" data-period-field="<%= field %>">
            <%= form.label field, field == :starts_on ? "Дата начала" : "Дата окончания", data: { date_label: field } %>
            <div class="date-entry" data-date-entry>
              <%= form.text_field field, required: true, inputmode: "numeric",
                autocomplete: "off", maxlength: 10, placeholder: "ДД.ММ.ГГГГ",
                pattern: "[0-9]{2}[.][0-9]{2}[.][0-9]{4}",
                aria: { describedby: "leave_request_#{field}_error" },
                value: @date_inputs&.dig(field) || @leave_request.public_send(field)&.strftime("%d.%m.%Y") %>
              <button type="button" class="date-entry__button" data-date-picker-button hidden
                aria-label="Выбрать <%= field == :starts_on ? "дату начала" : "дату окончания" %>">📅</button>
              <dialog class="date-entry__dialog" data-date-dialog
                data-calendar-first-year="2025"
                data-calendar-min="<%= Date.current.iso8601 %>"
                data-calendar-max="<%= Date.current.end_of_year.iso8601 %>"
                data-statutory-max="<%= Date.new(CalendarWindow::LAST_YEAR, 12, 31).iso8601 %>"
                data-calendar-available-years="<%= @available_years.join(',') %>"
                aria-label="Выбор <%= field == :starts_on ? "даты начала" : "даты окончания" %>">
                <div class="date-entry__controls">
                  <label>Месяц <select data-calendar-month></select></label>
                  <label>Год <select data-calendar-year></select></label>
                </div>
                <div class="date-entry__days" data-calendar-days></div>
                <button type="button" class="button button--secondary" data-calendar-close>Закрыть</button>
              </dialog>
            </div>
            <p id="leave_request_<%= field %>_error" class="field-error" aria-live="polite" hidden></p>
          </div>
        <% end %>
      <%= tag.div class: "field field--full leave-full-day", data: { full_day_field: true },
        hidden: @leave_request.leave_type&.full_day_only? do %>
        <label class="checkbox-field" for="leave_request_full_day">
          <%= check_box_tag "leave_request[full_day]", "1", @full_day,
            id: "leave_request_full_day", data: { full_day: true },
            disabled: @leave_request.leave_type&.full_day_only? %>
          <span>Весь день <small>Все выбранные календарные даты целиком (00:00–24:00)</small></span>
        </label>
      <% end %>
      <div class="field" data-time-field>
        <%= form.label :start_time, "Время начала" %>
        <%= form.select :start_time, LeaveRequest::START_TIME_OPTIONS,
          { selected: form.object.start_time }, required: true, data: { workday_start: true } %>
      </div>
      <div class="field" data-time-field>
        <%= form.label :end_time, "Время окончания" %>
        <%= form.select :end_time, LeaveRequest::END_TIME_OPTIONS,
          { selected: form.object.end_time }, required: true, data: { workday_end: true },
          aria: { describedby: "leave_request_end_time_error" } %>
        <p id="leave_request_end_time_error" class="field-error" aria-live="polite" hidden></p>
      </div>
      <%= tag.p class: "field-hint field--full leave-time-hint", data: { partial_day_hint: true },
        hidden: @leave_request.leave_type.nil? || @leave_request.leave_type.full_day_only? do %>
        Снимите отметку «Весь день», чтобы указать время начала первого и окончания последнего дня с шагом 15 минут в пределах 09:00–18:00. Промежуточные даты входят целиком.
      <% end %>

      <section class="leave-planner field--full" data-leave-planner
        data-calendar-available-years="<%= @available_years.join(',') %>"
        data-public-holidays="<%= @public_holidays.map(&:iso8601).join(",") %>"
        aria-labelledby="leave-planner-title">
        <div class="leave-planner__heading">
          <h2 id="leave-planner-title">План периода</h2>
          <p data-planner-summary aria-live="polite">Выберите даты начала и окончания.</p>
        </div>
        <ol class="leave-planner__days" data-planner-days></ol>
        <p class="leave-planner__note" data-planner-note>Промежуточные даты входят целиком. Итоговая длительность рассчитывается по правилам выбранного вида отпуска.</p>
          <p class="field-hint" data-sick-long-warning role="status" hidden>Длительный период — более 30 календарных дней. Проверьте даты; руководитель должен подтвердить период отсутствия.</p>
      </section>

        <div class="field field--full">
          <%= form.label :employee_comment, "Комментарий" %>
          <%= form.text_area :employee_comment,
          maxlength: LeaveRequest::COMMENT_MAX_LENGTH,
            placeholder: "Необязательно: добавьте важные детали" %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Отправить заявку" %>
        <%= link_to "Отмена", leave_requests_path, class: "button button--secondary" %>
      </div>
    <% end %>
  </section>
</main>
