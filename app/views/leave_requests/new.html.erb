<main class="page page--narrow">
  <header class="page-header">
    <div>
      <p class="eyebrow">Новая заявка</p>
      <h1>Запланировать отпуск</h1>
      <p class="lede">Укажите вид отпуска и желаемые даты.</p>
    </div>
  </header>

  <% if @leave_request.errors.any? %>
    <div class="error-summary" role="alert">
      <strong>Проверьте заполнение формы</strong>
      <ul>
        <% @leave_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card form-card">
    <%= form_with model: @leave_request do |form| %>
      <div class="form-grid">
        <div class="field field--full">
          <%= form.label :leave_type_id, "Вид отпуска" %>
          <%= form.collection_select :leave_type_id, @leave_types, :id, :name,
            { prompt: "Выберите вид отпуска" }, required: true %>
        </div>

        <div class="field">
          <%= form.label :starts_on, "Дата начала" %>
        <%= form.date_field :starts_on, required: true,
            min: Date.current.beginning_of_year.iso8601,
            max: Date.current.end_of_year.iso8601,
          value: @leave_request.starts_on.is_a?(Date) ? @leave_request.starts_on : nil %>
        </div>

        <div class="field">
          <%= form.label :ends_on, "Дата окончания" %>
        <%= form.date_field :ends_on, required: true,
            min: Date.current.beginning_of_year.iso8601,
            max: Date.current.end_of_year.iso8601,
          value: @leave_request.ends_on.is_a?(Date) ? @leave_request.ends_on : nil %>
        </div>
      <div class="field">
        <%= form.label :start_part, "Начало периода" %>
        <%= form.select :start_part, [["С утра", "morning"], ["После полудня", "afternoon"]] %>
      </div>
      <div class="field">
        <%= form.label :end_part, "Окончание периода" %>
        <%= form.select :end_part, [["До полудня", "morning"], ["До конца дня", "afternoon"]] %>
      </div>

        <div class="field field--full">
          <%= form.label :employee_comment, "Комментарий" %>
          <%= form.text_area :employee_comment,
          maxlength: LeaveRequest::COMMENT_MAX_LENGTH,
            placeholder: "Необязательно: добавьте важные детали" %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Отправить заявку" %>
        <%= link_to "Отмена", leave_requests_path, class: "button button--secondary" %>
      </div>
    <% end %>
  </section>
</main>
