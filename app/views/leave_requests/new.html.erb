<% content_for :head do %>
  <%= javascript_include_tag "leave_request_dates", defer: true %>
<% end %>

<main class="page page--narrow">
  <header class="page-header">
    <div>
      <p class="eyebrow">Новая заявка</p>
      <h1>Запланировать отпуск</h1>
      <p class="lede">Выберите даты и при необходимости уточните время крайних дней.</p>
    </div>
  </header>

  <% if @leave_request.errors.any? %>
    <div class="error-summary" role="alert">
      <strong>Проверьте заполнение формы</strong>
      <ul>
        <% @leave_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card form-card">
    <%= form_with model: @leave_request do |form| %>
      <div class="form-grid">
        <div class="field field--full">
          <%= form.label :leave_type_id, "Вид отпуска" %>
          <%= form.collection_select :leave_type_id, @leave_types, :id, :name,
            { prompt: "Выберите вид отпуска" },
            required: true, data: { planner_type: true,
              annual_type_id: @leave_types.find { |type| type.code == "ANNUAL" }&.id,
              full_day_type_ids: @leave_types.select(&:full_day_only?).map(&:id).join(","),
              statutory_type_ids: @leave_types.select(&:statutory_leave?).map(&:id).join(","),
              family_type_ids: @leave_types.select(&:family_leave?).map(&:id).join(","),
              childcare_type_id: @leave_types.find { |type| type.code == "CHILDCARE" }&.id,
              excluded_holiday_type_ids: @leave_types.select(&:exclude_public_holidays?).map(&:id).join(",") } %>
        </div>

        <%= form.hidden_field :resumes_request_id if @leave_request.resumes_request_id %>
        <div class="field field--full" data-childcare-field>
          <%= form.label :child_born_on, "Дата рождения ребёнка (для отпуска по уходу)" %>
          <%= form.date_field :child_born_on, max: Date.current %>
        </div>
        <div class="field field--full" data-childcare-field>
          <%= form.label :care_relationship, "Кто осуществляет уход" %>
          <%= form.select :care_relationship, LeaveRequest.care_relationships.keys.map { |key| [care_relationship_label(key), key] }, include_blank: "Выберите для отпуска по уходу" %>
        </div>
        <p class="field-hint field--full">Ежегодный отпуск и семейные отпуска оформляются на полные календарные дни и могут переходить в следующий год. Для беременности и родов укажите даты по заявлению и документу; 140/156/194 дня — обычные варианты, не единственные допустимые сроки. Семейный отпуск регистрирует администратор. Выходной в день рождения — один полный день один раз в календарном году.</p>

        <% %i[starts_on ends_on].each do |field| %>
          <div class="field">
            <%= form.label field, field == :starts_on ? "Дата начала" : "Дата окончания" %>
            <div class="date-entry" data-date-entry>
              <%= form.text_field field, required: true, inputmode: "numeric",
                autocomplete: "off", maxlength: 10, placeholder: "ДД.ММ.ГГГГ",
                pattern: "[0-9]{2}[.][0-9]{2}[.][0-9]{4}",
                value: @date_inputs&.dig(field) || @leave_request.public_send(field)&.strftime("%d.%m.%Y") %>
              <button type="button" class="date-entry__button" data-date-picker-button hidden
                aria-label="Выбрать <%= field == :starts_on ? "дату начала" : "дату окончания" %>">📅</button>
              <dialog class="date-entry__dialog" data-date-dialog
                data-calendar-first-year="2025"
                data-calendar-min="<%= Date.current.iso8601 %>"
                data-calendar-max="<%= Date.current.end_of_year.iso8601 %>"
                data-statutory-max="<%= Date.new(CalendarWindow::LAST_YEAR, 12, 31).iso8601 %>"
                aria-label="Выбор <%= field == :starts_on ? "даты начала" : "даты окончания" %>">
                <div class="date-entry__controls">
                  <label>Месяц <select data-calendar-month></select></label>
                  <label>Год <select data-calendar-year></select></label>
                </div>
                <div class="date-entry__days" data-calendar-days></div>
                <button type="button" class="button button--secondary" data-calendar-close>Закрыть</button>
              </dialog>
            </div>
          </div>
        <% end %>
      <div class="field field--full leave-full-day">
        <label class="checkbox-field" for="leave_request_full_day">
          <%= check_box_tag "leave_request[full_day]", "1", @full_day,
            id: "leave_request_full_day", data: { full_day: true } %>
          <span>Весь день <small>Все выбранные календарные даты целиком (00:00–24:00)</small></span>
        </label>
      </div>
      <div class="field" data-time-field>
        <%= form.label :start_time, "Время начала" %>
        <%= form.select :start_time, LeaveRequest::START_TIME_OPTIONS,
          { selected: form.object.start_time }, required: true, data: { workday_start: true } %>
      </div>
      <div class="field" data-time-field>
        <%= form.label :end_time, "Время окончания" %>
        <%= form.select :end_time, LeaveRequest::END_TIME_OPTIONS,
          { selected: form.object.end_time }, required: true, data: { workday_end: true } %>
      </div>
      <p class="field-hint field--full leave-time-hint">Снимите отметку «Весь день», чтобы указать время начала первого и окончания последнего дня с шагом 15 минут в пределах 09:00–18:00. Промежуточные даты входят целиком.</p>

      <section class="leave-planner field--full" data-leave-planner
        data-public-holidays="<%= @public_holidays.map(&:iso8601).join(",") %>"
        aria-labelledby="leave-planner-title">
        <div class="leave-planner__heading">
          <h2 id="leave-planner-title">План периода</h2>
          <p data-planner-summary aria-live="polite">Выберите даты начала и окончания.</p>
        </div>
        <ol class="leave-planner__days" data-planner-days></ol>
        <p class="leave-planner__note" data-planner-note>Промежуточные даты входят целиком. Итоговая длительность рассчитывается по правилам выбранного вида отпуска.</p>
      </section>

        <div class="field field--full">
          <%= form.label :employee_comment, "Комментарий" %>
          <%= form.text_area :employee_comment,
          maxlength: LeaveRequest::COMMENT_MAX_LENGTH,
            placeholder: "Необязательно: добавьте важные детали" %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Отправить заявку" %>
        <%= link_to "Отмена", leave_requests_path, class: "button button--secondary" %>
      </div>
    <% end %>
  </section>
</main>
