<% content_for :head do %>
  <%= javascript_include_tag "leave_request_dates", defer: true %>
<% end %>

<main class="page page--narrow">
  <header class="page-header">
    <div>
      <p class="eyebrow">Новая заявка</p>
      <h1>Запланировать отпуск</h1>
      <p class="lede">Укажите вид отсутствия, даты и точное время.</p>
    </div>
  </header>

  <% if @leave_request.errors.any? %>
    <div class="error-summary" role="alert">
      <strong>Проверьте заполнение формы</strong>
      <ul>
        <% @leave_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="card form-card">
    <%= form_with model: @leave_request do |form| %>
      <div class="form-grid">
        <div class="field field--full">
          <%= form.label :leave_type_id, "Вид отпуска" %>
          <%= form.collection_select :leave_type_id, @leave_types, :id, :name,
            { prompt: "Выберите вид отпуска" }, required: true %>
        </div>

        <% %i[starts_on ends_on].each do |field| %>
          <div class="field">
            <%= form.label field, field == :starts_on ? "Дата начала" : "Дата окончания" %>
            <div class="date-entry" data-date-entry>
              <%= form.text_field field, required: true, inputmode: "numeric",
                autocomplete: "off", maxlength: 10, placeholder: "ДД.ММ.ГГГГ",
                pattern: "[0-9]{2}[.][0-9]{2}[.][0-9]{4}",
                value: @date_inputs&.dig(field) || @leave_request.public_send(field)&.strftime("%d.%m.%Y") %>
              <button type="button" class="date-entry__button" data-date-picker-button hidden
                aria-label="Выбрать <%= field == :starts_on ? "дату начала" : "дату окончания" %>">📅</button>
              <dialog class="date-entry__dialog" data-date-dialog
                data-calendar-first-year="2025"
                data-calendar-min="<%= Date.current.iso8601 %>"
                data-calendar-max="<%= Date.current.end_of_year.iso8601 %>"
                aria-label="Выбор <%= field == :starts_on ? "даты начала" : "даты окончания" %>">
                <div class="date-entry__controls">
                  <label>Месяц <select data-calendar-month></select></label>
                  <label>Год <select data-calendar-year></select></label>
                </div>
                <div class="date-entry__days" data-calendar-days></div>
                <button type="button" class="button button--secondary" data-calendar-close>Закрыть</button>
              </dialog>
            </div>
          </div>
        <% end %>
      <div class="field">
        <%= form.label :start_time, "Время начала" %>
        <%= form.select :start_time, LeaveRequest::START_TIME_OPTIONS, {}, required: true %>
      </div>
      <div class="field">
        <%= form.label :end_time, "Время окончания" %>
        <%= form.select :end_time, LeaveRequest::END_TIME_OPTIONS, {}, required: true %>
        <p class="field-hint">Время выбирается с шагом 15 минут. Для полного календарного дня выберите 00:00–24:00.</p>
      </div>

        <div class="field field--full">
          <%= form.label :employee_comment, "Комментарий" %>
          <%= form.text_area :employee_comment,
          maxlength: LeaveRequest::COMMENT_MAX_LENGTH,
            placeholder: "Необязательно: добавьте важные детали" %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Отправить заявку" %>
        <%= link_to "Отмена", leave_requests_path, class: "button button--secondary" %>
      </div>
    <% end %>
  </section>
</main>
