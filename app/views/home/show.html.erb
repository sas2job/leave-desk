<main class="page">
  <section class="page-header">
    <div>
      <p class="eyebrow">Рабочее пространство</p>
      <h1>Здравствуйте, <%= Current.user.name %></h1>
      <p class="lede">Управляйте отпусками и следите за статусом заявок в одном месте.</p>
    </div>
  </section>

  <div class="dashboard-grid">
    <%= link_to leave_requests_path, class: "card action-card" do %>
      <span class="action-card__icon" aria-hidden="true">М</span>
      <h2>Мои заявки</h2>
      <p>Создавайте заявки и отслеживайте принятые решения.</p>
    <% end %>

    <% if Current.user.manager? %>
      <%= link_to manager_leave_requests_path, class: "card action-card" do %>
        <span class="action-card__icon" aria-hidden="true">К</span>
        <h2>Заявки команды</h2>
        <p>Рассматривайте отпуска непосредственных подчинённых.</p>
      <% end %>
    <% end %>

    <% if Current.user.administrator? %>
      <%= link_to admin_leave_types_path, class: "card action-card" do %>
        <span class="action-card__icon" aria-hidden="true">А</span>
        <h2>Виды отпусков</h2>
        <p>Настраивайте доступные сотрудникам варианты отпусков.</p>
      <% end %>
    <% end %>
  </div>
</main>
