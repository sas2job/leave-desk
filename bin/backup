#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${DATABASE_URL:-}" ]]; then
  echo "DATABASE_URL is required" >&2
  exit 1
fi

if [[ -z "${BACKUP_DIRECTORY:-}" || "${BACKUP_DIRECTORY}" != /* ]]; then
  echo "BACKUP_DIRECTORY must be an absolute path outside the source tree" >&2
  exit 1
fi

source_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
backup_directory="${BACKUP_DIRECTORY}"
mkdir -p "$backup_directory"
backup_directory="$(cd "$backup_directory" && pwd -P)"
if [[ "$backup_directory" == "$source_directory" || "$backup_directory" == "$source_directory/"* ]]; then
  echo "BACKUP_DIRECTORY must be outside the source tree" >&2
  exit 1
fi
chmod 700 "$backup_directory"
umask 077

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary="$(mktemp "$backup_directory/.leave-desk-$timestamp.XXXXXXXX")"
suffix="${temporary##*.}"
destination="$backup_directory/leave-desk-$timestamp-$suffix.dump"
checksum_temporary="$temporary.sha256"
published_archive=false
complete=false

cleanup() {
  if [[ "$published_archive" == true && "$complete" != true ]]; then
    rm -f -- "$destination"
  fi
  rm -f -- "$temporary" "$checksum_temporary"
}
trap cleanup EXIT

pg_dump --format=custom --no-owner --no-privileges \
  --file="$temporary" "$DATABASE_URL"
destination_name="$(basename "$destination")"
checksum_output="$(sha256sum < "$temporary")"
digest="${checksum_output%% *}"
printf '%s  %s\n' "$digest" "$destination_name" > "$checksum_temporary"
ln -- "$temporary" "$destination"
published_archive=true
ln -- "$checksum_temporary" "$destination.sha256"
complete=true

echo "Backup created: $destination"
