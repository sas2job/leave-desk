#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || -z "$1" || ! -f "$1" ]]; then
  echo "Usage: RESTORE_DATABASE_URL=... ALLOW_DATABASE_RESTORE=yes bin/restore PATH_TO_DUMP" >&2
  exit 2
fi
archive=$1
if [[ -z "${RESTORE_DATABASE_URL:-}" ]]; then
  echo "RESTORE_DATABASE_URL is required" >&2
  exit 1
fi
if [[ ! "$RESTORE_DATABASE_URL" =~ ^postgres(ql)?://[^/?#]*/[^/?#]+([?][^#]*)?$ ||
      "$RESTORE_DATABASE_URL" =~ [[:space:][:cntrl:]] ]]; then
  echo "RESTORE_DATABASE_URL must be a PostgreSQL URL with a database path; example: postgresql:///isolated" >&2
  exit 2
fi
if [[ "${ALLOW_DATABASE_RESTORE:-}" != "yes" ]]; then
  echo "Set ALLOW_DATABASE_RESTORE=yes to confirm restoration" >&2
  exit 1
fi

if (( BASH_VERSINFO[0] < 4 )) || ! type -t mapfile >/dev/null; then
  echo "bin/restore requires Bash 4 or newer" >&2
  exit 1
fi
for prerequisite in dirname basename sha256sum pg_restore stat; do
  if ! command -v "$prerequisite" >/dev/null; then
    echo "bin/restore requires $prerequisite in PATH" >&2
    exit 1
  fi
done

checksum="$archive.sha256"
if [[ ! -f "$checksum" ]]; then
  echo "Checksum file is missing for the selected archive" >&2
  exit 2
fi
if (( $(stat -Lc %s -- "$checksum") > 512 )); then
  echo "Checksum file exceeds 512 bytes; expected one SHA-256 entry" >&2
  exit 2
fi
archive_directory="$(dirname -- "$archive")"
archive_name="$(basename -- "$archive")"
mapfile -t checksum_entries < "$checksum"
if [[ "${#checksum_entries[@]}" -ne 1 ||
      ! "${checksum_entries[0]}" =~ ^([[:xdigit:]]{64})[[:space:]][[:space:]](.+)$ ||
      "${BASH_REMATCH[2]}" != "$archive_name" ]]; then
  echo "Checksum file must contain one entry for the selected archive" >&2
  exit 2
fi
if ! (cd "$archive_directory" && sha256sum --check --status -- "$archive_name.sha256"); then
  echo "Archive checksum does not match" >&2
  exit 2
fi

pg_restore --exit-on-error --single-transaction --no-owner --no-privileges \
  --dbname="$RESTORE_DATABASE_URL" -- "$archive"

echo "Restore completed. Run application checks against the restored database."
